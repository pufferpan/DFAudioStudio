<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DFAudioStudio.App.Pages.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DFAudioStudio.Core.Models"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        识别队列：卡片式三段 —— 状态（大数字 + 状态词）/ 当前文件与识别文本 / 失败项。
        按钮只用两种样式：主按钮（开始识别）+ 次按钮（其余动作），每个按钮都带官方矢量图标。
        说明性长句全部删掉，模型与消息压成一行 Caption。
    -->
    <ScrollViewer Padding="{StaticResource ApplePageMargin}"
                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel Spacing="40">

                <!-- ── 标题 ───────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="识别队列" Style="{StaticResource ApplePageTitleStyle}" />
                    <TextBlock Style="{StaticResource AppleSecondaryStyle}" MaxLines="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                        <Run Text=" · 剩余 " />
                        <Run Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                        <Run Text=" 条" />
                    </TextBlock>
                </StackPanel>

                <!-- ── 一、状态：大数字 + 状态词 ─────────────────────────── -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                       Style="{StaticResource AppleHeadlineStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="状态" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.DoneText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="已完成" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="剩余待识别" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.FailedText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="失败" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 二、控制按钮（两种样式 + 官方矢量图标） ───────────── -->
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="开始识别" Style="{StaticResource ApplePrimaryButtonStyle}"
                                Click="Start_Click" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource OnAccent}" VerticalAlignment="Center" />
                                <TextBlock Text="开始识别"
                                           Foreground="{ThemeResource OnAccent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="暂停" Style="{StaticResource AppleSecondaryButtonStyle}"
                                Click="Pause_Click" IsEnabled="{x:Bind ViewModel.CanPause, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE769;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="暂停"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="继续" Style="{StaticResource AppleSecondaryButtonStyle}"
                                Click="Resume_Click" IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="继续"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="停止" Style="{StaticResource AppleSecondaryButtonStyle}"
                                Click="Stop_Click" IsEnabled="{x:Bind ViewModel.CanStop, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="停止"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="刷新" Style="{StaticResource AppleSecondaryButtonStyle}"
                                Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="刷新"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="重试失败项" Style="{StaticResource AppleSecondaryButtonStyle}"
                                Click="RetryAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="重试失败项"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Width="14" Height="14" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.ModelText, Mode=OneWay}"
                               Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.MessageText, Mode=OneWay}"
                               Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- ── 三、当前文件 / 识别文本 ──────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Spacing="6">
                            <TextBlock Text="当前文件" Style="{StaticResource AppleCardCaptionStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CurrentFile, Mode=OneWay}"
                                       Style="{StaticResource AppleCardTitleStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <ScrollViewer x:Name="TextScroller" Grid.Row="1" Height="180"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                            <TextBlock Text="{x:Bind ViewModel.CurrentText, Mode=OneWay}"
                                       Style="{StaticResource AppleReadingStyle}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── 四、失败项 ──────────────────────────────────────── -->
                <StackPanel Spacing="16">
                    <TextBlock Text="失败项" Style="{StaticResource AppleSectionTitleStyle}" />

                    <ListView Background="Transparent"
                              SelectionMode="None"
                              ItemContainerStyle="{StaticResource AppleAudioRowStyle}"
                              ItemsSource="{x:Bind ViewModel.FailedItems, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AudioItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind FileName}"
                                                   FontSize="17"
                                                   Foreground="{ThemeResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Text="{x:Bind LastError}"
                                                   Style="{StaticResource AppleMetaStyle}"
                                                   MaxLines="1" />
                                    </StackPanel>

                                    <!--
                                        每行一个「重试」：可用性绑在这一行数据自己的状态上
                                        （IsEnabled ← Status 经 RetryableStatus 转换器：只有「未处理 / 失败」才放行，
                                         取值不是一条真实条目的状态＝无该项，按钮置灰 + ToolTip）。
                                        这里没有「选中」概念（ListView 是 SelectionMode=None），
                                        Tag 兜底绑定同一条数据，万一 DataContext 取不到也能重试成功。
                                    -->
                                    <Button AutomationProperties.Name="重试" Grid.Column="1"
                                            Style="{StaticResource AppleTextLinkButtonStyle}"
                                            VerticalAlignment="Center"
                                            IsEnabled="{x:Bind Status, Mode=OneWay, Converter={StaticResource RetryableStatus}}"
                                            Tag="{Binding}"
                                            ToolTipService.ToolTip="把这一条重新加入识别队列"
                                            Click="RetryOne_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE72C;" FontSize="15"
                                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                      Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                            <TextBlock Text="重试"
                                                       Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
