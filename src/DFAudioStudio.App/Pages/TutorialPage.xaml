<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DFAudioStudio.App.Pages.TutorialPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        新手教程：每一步一张卡片。卡片初始在下方（TranslateTransform.Y = 56）且透明，
        进入视口时用「非线性缓动」升到原位 —— 指数缓动 EaseOut（快进慢停），不是匀速。
        动画由 TutorialPage.xaml.cs 的 RevealCard() 负责，滚动到哪一步就升哪一步。
    -->
    <ScrollViewer x:Name="Scroller"
                  Padding="{StaticResource ApplePageMargin}"
                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                  ViewChanged="Scroller_ViewChanged">
        <Grid MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel Spacing="40">

                <!-- ── 标题 ───────────────────────────────────────────── -->
                <StackPanel x:Name="HeaderPanel" Spacing="12">
                    <TextBlock Text="新手教程" Style="{StaticResource ApplePageTitleStyle}" />
                    <TextBlock Text="从「目录设置」到「识别出字幕」，照着走一遍就能上手"
                               Style="{StaticResource AppleSecondaryStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button AutomationProperties.Name="重看首次引导" Style="{StaticResource AppleSecondaryButtonStyle}"
                                VerticalAlignment="Center" Click="ReplayOnboarding_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7BE;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="重看首次引导" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="重播动画" Style="{StaticResource AppleSecondaryButtonStyle}"
                                VerticalAlignment="Center" Click="Replay_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="重播动画" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="回到顶部" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center" Click="Top_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74A;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="回到顶部" Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 步骤卡片容器：所有卡片在代码里统一挂初始位移 / 透明度 -->
                <StackPanel x:Name="StepsPanel" Spacing="16">

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="1" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="先告诉它音频在哪" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="打开左侧「设置」，填两个目录：Media（WwiseAudio\Media）与 Localized（WwiseAudio\Localized）。两个都可以点「浏览」直接选文件夹，选完立即生效、自动保存。扫描只认 .wav，没改动过的文件会跳过，所以之后再扫很快。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="小提示：目录里的音频数量越多，第一次建索引越久；可以先只填 Media，Localized 留空也能用。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="2" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="建索引：把音频扫进库" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="回到「概览」，点「全量扫描索引」。扫描过程会实时显示进度与当前文件；中途关掉软件也没关系，下次打开接着扫。扫完就能在左侧「分区导航」里按 类型 / 场景 / 干员 / 活动 / 地图 等维度浏览了。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="索引存在设置页底部显示的数据目录里（index.db），换电脑时把这个文件一起带走即可。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="3" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="准备识别模型（两种方式）" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="识别需要 whisper.cpp 的 ggml 模型。方式一：在设置页「识别模型」里选一个模型点「开始下载」（推荐 ggml-small，中文可用、速度可接受）。方式二：本地已经有模型，点「识别文件夹」选模型所在文件夹 —— 会自动扫描（含两层子目录）把 ggml-*.bin 找出来：只找到一个就自动填好，找到多个会让你挑一个，一个都没有会明确告诉你。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="模型路径也可以直接填文件夹，程序会自动识别；模型文件请放纯英文路径（Whisper 的原生库处理中文路径容易出问题）。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="4" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="开始识别：队列可以随时暂停" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="「概览」页点「开始识别（手动）」把待识别的语音排进队列，然后到左侧「识别队列」看进度：可以暂停 / 继续 / 停止，也能看当前文件与识别出的文本。默认不自动开始识别（启动更快），想要开机就跑，可以在设置页打开「启动时自动开始识别」。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="识别是纯 CPU 的，慢是正常的；并发数调大能快一点，但会更吃 CPU。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="5" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="查与听：搜索、播放、变速变调" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="进入任意分区后用顶部搜索框搜文件名 / 识别文本，配合 分区 / 干员 / 活动 / 地图 / 子分类 / 识别状态 二次筛选。选中一条即可试听：播放条上有「变速（保持音调）」与「变调（保持速度）」两个滑块，拖动实时生效，变速不变调、变调不变速。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="识别过的条目能在右侧看到文本，并可「导出 SRT」或整体导出 CSV。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="6" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="外观：主题与片头" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="设置页「外观」里三选：跟随系统 / 浅色 / 深色 —— 选完立即生效并保存，和侧栏底部的开关是同一个值。喜欢开机有点仪式感，可以在「启动片头」里指定一个 mp4，启动时播放；不想看就把开关关掉。" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AppleCardBorderStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource Accent}">
                                    <TextBlock Text="7" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource OnAccent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="出问题了先看这两处" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource AppleBodyStyle}" TextWrapping="Wrap"
                                       Text="① 设置页底部的「数据目录」里有 logs 文件夹，日志按天记（app-yyyyMMdd.log），扫描 / 识别 / 播放的每一步都在里面。② 识别不出文本时：先确认模型路径是不是「文件存在」，再看看是不是把音乐当语音跳过了（「连音乐一起识别」开关）。" />
                            <TextBlock Style="{StaticResource AppleCaptionStyle}" TextWrapping="Wrap"
                                       Text="设置项都是即改即存，没有「保存」按钮；想还原某一项，把它改回原来的值就行。" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
