<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DFAudioStudio.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        设置：几组 CardBorder，每组一个 CardTitle + 若干行（行高 56、不用分割线、用 16px 间距分隔）。
        每一行只有一个主控件并占满卡片宽度（控件自带 Placeholder / Header 说明用途，不再画标签列，
        这样窄窗口也不会把输入框挤到看不见）。
        长段说明一律压成一行 Caption；模型下载区保留下拉与进度条但视觉弱化为次级。
    -->
    <ScrollViewer Padding="{StaticResource ApplePageMargin}"
                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel Spacing="40">

                <!-- ── 标题 ───────────────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="设置" Style="{StaticResource ApplePageTitleStyle}" />
                    <TextBlock Text="所有改动自动保存，改完即生效" Style="{StaticResource AppleSecondaryStyle}" />
                </StackPanel>

                <!-- ── 一、音频目录 ───────────────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="音频目录" Style="{StaticResource AppleCardTitleStyle}" />

                        <Grid Height="56" HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MediaRootBox" Grid.Column="0" VerticalAlignment="Center" Height="36"
                                     Style="{StaticResource AppleSubtleTextBoxStyle}"
                                     Text="{x:Bind ViewModel.MediaRoot, Mode=OneWay}"
                                     TextChanged="MediaRoot_TextChanged"
                                     PlaceholderText="Media 目录（WwiseAudio\Media）" />
                            <Button AutomationProperties.Name="浏览" Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickMediaRoot_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Height="56" HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalizedRootBox" Grid.Column="0" VerticalAlignment="Center" Height="36"
                                     Style="{StaticResource AppleSubtleTextBoxStyle}"
                                     Text="{x:Bind ViewModel.LocalizedRoot, Mode=OneWay}"
                                     TextChanged="LocalizedRoot_TextChanged"
                                     PlaceholderText="Localized 目录（WwiseAudio\Localized）" />
                            <Button AutomationProperties.Name="浏览" Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickLocalizedRoot_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="扫描只认 *.wav，未改动的文件会跳过"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ── 二、识别模型 ───────────────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="识别模型" Style="{StaticResource AppleCardTitleStyle}" />

                        <Grid Height="56" HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" VerticalAlignment="Center" Height="36"
                                     Style="{StaticResource AppleSubtleTextBoxStyle}"
                                     AutomationProperties.Name="模型路径"
                                     Text="{x:Bind ViewModel.ModelPath, Mode=OneWay}"
                                     TextChanged="ModelPath_TextChanged"
                                     LostFocus="ModelPath_LostFocus"
                                     PlaceholderText="ggml-*.bin 完整路径，或直接填模型文件夹" />
                            <Button AutomationProperties.Name="选择模型文件" Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickModel_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="选择文件"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- 自动识别：选一个文件夹，扫里面（含两层子目录）有没有 ggml-*.bin，找到就自动填上 -->
                            <Button AutomationProperties.Name="识别模型文件夹" Grid.Column="2"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickModelFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE721;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="识别文件夹"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.ModelHint, Mode=OneWay}"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" TextWrapping="Wrap" />

                        <!-- 自动识别结论 -->
                        <TextBlock Text="{x:Bind ViewModel.FolderScanHint, Mode=OneWay}"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" TextWrapping="Wrap"
                                   Foreground="{ThemeResource Accent}" />

                        <!-- 文件夹里有多个模型时才显示：选一个 -->
                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.MultipleModelsVisibility, Mode=OneWay}">
                            <TextBlock Text="文件夹里找到多个模型，选一个用" Style="{StaticResource AppleCaptionStyle}" Margin="2,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" Height="36"
                                      Style="{StaticResource AppleSubtleComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource AppleSubtleComboBoxItemStyle}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="文件夹里的模型"
                                      ItemsSource="{x:Bind ViewModel.ModelsInFolder, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedModelInFolder, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Text="模型越大越准、越慢"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />

                        <!-- 下载区：次级视觉，弱化的下拉 + 细进度条 -->
                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox Grid.Row="0" Grid.Column="0" Height="36" HorizontalAlignment="Stretch"
                                      Style="{StaticResource AppleSubtleComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource AppleSubtleComboBoxItemStyle}"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{x:Bind ViewModel.Models, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" />

                            <CheckBox Grid.Row="0" Grid.Column="1" Content="使用镜像"
                                      Style="{StaticResource AppleSubtleCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.UseMirror, Mode=TwoWay}" />

                            <Button AutomationProperties.Name="开始下载" Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                                    Click="Download_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="开始下载"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3"
                                         Style="{StaticResource AppleThinProgressBarStyle}"
                                         Maximum="100"
                                         Value="{x:Bind ViewModel.DownloadPercent, Mode=OneWay}" />

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="{x:Bind ViewModel.DownloadText, Mode=OneWay}"
                                           Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <Button AutomationProperties.Name="取消下载" Style="{StaticResource AppleTextLinkButtonStyle}"
                                        VerticalAlignment="Center" Click="CancelDownload_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="15"
                                                  FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                  Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Text="取消下载"
                                                   Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 三、识别参数 ───────────────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="识别参数" Style="{StaticResource AppleCardTitleStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="识别语言" Style="{StaticResource AppleCaptionStyle}" Margin="2,0,0,0" />
                            <ComboBox HorizontalAlignment="Stretch" Height="36"
                                      Style="{StaticResource AppleSubtleComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource AppleSubtleComboBoxItemStyle}"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="识别并发数" Style="{StaticResource AppleCaptionStyle}" Margin="2,0,0,0" />
                            <NumberBox HorizontalAlignment="Stretch" Height="36"
                                       Style="{StaticResource AppleSubtleNumberBoxStyle}"
                                       Minimum="1" Maximum="8" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.Parallelism, Mode=TwoWay}" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="单文件识别超时（分钟）" Style="{StaticResource AppleCaptionStyle}" Margin="2,0,0,0" />
                            <NumberBox HorizontalAlignment="Stretch" Height="36"
                                       Style="{StaticResource AppleSubtleNumberBoxStyle}"
                                       Minimum="1" Maximum="600" SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       Value="{x:Bind ViewModel.TimeoutMinutes, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid Height="56" HorizontalAlignment="Stretch">
                            <CheckBox Content="连音乐一起识别"
                                      Style="{StaticResource AppleSubtleCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.TranscribeMusic, Mode=TwoWay}" />
                        </Grid>

                        <Grid Height="56" HorizontalAlignment="Stretch">
                            <CheckBox Content="启动时自动开始识别"
                                      Style="{StaticResource AppleSubtleCheckBoxStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{x:Bind ViewModel.AutoStartTranscription, Mode=TwoWay}" />
                        </Grid>

                        <TextBlock Text="默认关闭，需要时手动开始"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- ── 四、外观（主题） ───────────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="外观" Style="{StaticResource AppleCardTitleStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="主题" Style="{StaticResource AppleCaptionStyle}" Margin="2,0,0,0" />
                            <!-- 三选：跟随系统 / 浅色 / 深色。与侧栏底部的开关同步：选完立即生效并保存 -->
                            <ComboBox HorizontalAlignment="Stretch" Height="36"
                                      Style="{StaticResource AppleSubtleComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource AppleSubtleComboBoxItemStyle}"
                                      DisplayMemberPath="Label"
                                      AutomationProperties.Name="主题"
                                      ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Text="跟随系统 / 浅色 / 深色：立即生效、立即保存，并与左侧导航栏底部的开关同步（切换时会淡入淡出过渡）。"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" />
                    </StackPanel>
                </Border>

                <!-- ── 五、启动片头 ───────────────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="启动片头" Style="{StaticResource AppleCardTitleStyle}" />

                        <ToggleSwitch AutomationProperties.Name="启动时播放片头"
                                      FontFamily="{StaticResource AppleFontFamily}"
                                      Header="启动时播放片头"
                                      OnContent="开"
                                      OffContent="关"
                                      IsOn="{x:Bind ViewModel.PlaySplashOnStartup, Mode=TwoWay}" />

                        <Grid HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SplashVideoBox" Grid.Column="0" VerticalAlignment="Center" Height="36"
                                     Style="{StaticResource AppleSubtleTextBoxStyle}"
                                     Text="{x:Bind ViewModel.SplashVideoPath, Mode=OneWay}"
                                     TextChanged="SplashVideoPath_TextChanged"
                                     PlaceholderText="片头视频（mp4）完整路径" />
                            <Button AutomationProperties.Name="选择片头视频" Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickSplashVideo_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="选择"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SplashVideoHint, Mode=OneWay}"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" />
                        <TextBlock Text="片头播放结束（或点了「跳过」）后会弹一次「关于」提示；找不到视频文件则直接跳过片头，不影响主界面。"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" />
                    </StackPanel>
                </Border>

                <!-- ── 六、导出目录与自动保存状态 ─────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="导出目录" Style="{StaticResource AppleCardTitleStyle}" />

                        <Grid Height="56" HorizontalAlignment="Stretch" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExportDirBox" Grid.Column="0" VerticalAlignment="Center" Height="36"
                                     Style="{StaticResource AppleSubtleTextBoxStyle}"
                                     AutomationProperties.Name="导出目录"
                                     Text="{x:Bind ViewModel.ExportDir, Mode=OneWay}"
                                     TextChanged="ExportDir_TextChanged"
                                     PlaceholderText="导出目录（CSV / SRT / TXT）" />
                            <Button AutomationProperties.Name="浏览导出目录" Grid.Column="1"
                                    Style="{StaticResource AppleSecondaryButtonStyle}"
                                    VerticalAlignment="Center" Click="PickExportDir_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="15"
                                              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                              Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                    <TextBlock Text="浏览"
                                               Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 自动保存：没有保存按钮，这里只报"刚刚存了什么" -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                       Style="{StaticResource AppleCaptionStyle}" MaxLines="2" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.DataDirText}"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="改动一律实时写入设置文件，没有「保存」按钮；想还原某一项，直接把它改回原来的值即可。"
                                   Style="{StaticResource AppleCaptionStyle}" MaxLines="2" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
