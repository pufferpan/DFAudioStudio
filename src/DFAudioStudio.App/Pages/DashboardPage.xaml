<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DFAudioStudio.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <!--
        概览：一屏只讲一件事 —— 音频库现在是什么状态。
        顶部一行大标题 + 一行状态，中间 4 张大数字卡片，再下面两个主按钮，最后是运行日志。
        所有解释性长句、分区明细、说明段落都删掉了，只在需要时由状态文字承担。
    -->
    <ScrollViewer Padding="{StaticResource ApplePageMargin}"
                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <Grid MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel Spacing="40">

                <!-- ── 标题 + 一句话状态 ─────────────────────────────────── -->
                <StackPanel Spacing="12">
                    <TextBlock Text="音频库" Style="{StaticResource ApplePageTitleStyle}" />
                    <TextBlock Style="{StaticResource AppleSecondaryStyle}" MaxLines="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                        <Run Text="条音频 · 已识别" />
                        <Run Text="{x:Bind ViewModel.DoneText, Mode=OneWay}" />
                        <Run Text="条" />
                    </TextBlock>
                </StackPanel>

                <!-- ── 4 张大数字卡片 ───────────────────────────────────── -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="总条目" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.DoneText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="已识别" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.PendingText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="待识别" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource AppleStatCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.WithTranscriptText, Mode=OneWay}" Style="{StaticResource AppleBigNumberStyle}" />
                            <TextBlock Text="有识别文本" Style="{StaticResource AppleCardCaptionStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── 主操作：两个按钮 + 四个文字链接（全部带官方矢量图标） ────── -->
                <StackPanel Spacing="24">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button Style="{StaticResource ApplePrimaryButtonStyle}"
                                AutomationProperties.Name="{x:Bind ViewModel.QueueButtonText, Mode=OneWay}"
                                Click="Queue_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource OnAccent}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.QueueButtonText, Mode=OneWay}"
                                           Foreground="{ThemeResource OnAccent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AppleSecondaryButtonStyle}"
                                AutomationProperties.Name="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                                Click="Scan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE721;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.ScanButtonText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="停止" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="StopQueue_Click"
                                IsEnabled="{x:Bind ViewModel.CanStopQueue, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="停止"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="取消扫描" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="CancelScan_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="取消扫描"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="刷新统计" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="Refresh_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="刷新统计"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="导出文本" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ExportTxt_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="导出文本"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 识别结果交换文件：导出后可以再导入回来，用来在机器之间搬识别成果 -->
                        <Button AutomationProperties.Name="导出识别结果" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ExportTranscripts_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE896;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="导出识别结果"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="导入识别结果" Style="{StaticResource AppleTextLinkButtonStyle}"
                                VerticalAlignment="Center"
                                Click="ImportTranscripts_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B5;" FontSize="15"
                                          FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                          Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="导入识别结果"
                                           Foreground="{ThemeResource Accent}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <ProgressRing Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center"
                                      IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    </StackPanel>

                    <!-- 进度只在进行时出现，静止时不留视觉噪音 -->
                    <ProgressBar Style="{StaticResource AppleThinProgressBarStyle}"
                                 Maximum="100"
                                 Value="{x:Bind ViewModel.ScanPercent, Mode=OneWay}"
                                 IsIndeterminate="{x:Bind ViewModel.ScanIndeterminate, Mode=OneWay}" />

                    <TextBlock Text="{x:Bind ViewModel.ScanStatusText, Mode=OneWay}"
                               Style="{StaticResource AppleSecondaryStyle}" MaxLines="2" />

                    <TextBlock Text="{x:Bind ViewModel.QueueDetailText, Mode=OneWay}"
                               Style="{StaticResource AppleCaptionStyle}" MaxLines="2" />

                    <TextBlock Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.LastScanText, Mode=OneWay}" />
                        <Run Text="　·　" />
                        <Run Text="{x:Bind ViewModel.QueueStateText, Mode=OneWay}" />
                        <Run Text="　·　" />
                        <Run Text="{x:Bind ViewModel.ModelText, Mode=OneWay}" />
                    </TextBlock>

                    <TextBlock Style="{StaticResource AppleCaptionStyle}" MaxLines="1" TextTrimming="CharacterEllipsis">
                        <Run Text="{x:Bind ViewModel.MediaRootText, Mode=OneWay}" />
                        <Run Text="　·　" />
                        <Run Text="{x:Bind ViewModel.LocalizedRootText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- ── 运行日志：卡片里的等宽小字 ─────────────────────────── -->
                <Border Style="{StaticResource AppleCardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="运行日志" Style="{StaticResource AppleCardTitleStyle}" Margin="0,0,0,16" />

                        <ScrollViewer x:Name="LogScroller" Grid.Row="1" Height="144"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
                            <TextBlock Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                                       Style="{StaticResource AppleLogTextStyle}" />
                        </ScrollViewer>
                    </Grid>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
