<?xml version="1.0" encoding="utf-8"?>
<!--
    AppleTheme.xaml —— 全应用唯一的视觉令牌与控件样式来源（极简 / 大量留白 / 无阴影）。

    设计约定：
    · 颜色只从这里取；页面里不再出现十六进制字面量（除非是一次性的描边衬度）。
    · 一律没有阴影、没有半透明模糊材质、没有装饰图形（只在下面出现 0 值说明）；
      全应用唯一的渐变是主窗口根 Grid 的三层三色来回渐变（见 MainWindow.xaml，画刷由本文件按主题提供）。
    · 按钮统一「小圆角矩形」（圆角 8，不再是胶囊），图标统一用微软官方矢量字体 Segoe Fluent Icons / Segoe MDL2 Assets。
    · 令牌键名不加前缀（PageBackground / TextPrimary / PageTitle …），与系统主题键不冲突；
      控件样式统一加 Apple 前缀（ApplePrimaryButtonStyle …）便于区分与复用。
    · 本文件由 App.xaml 的 MergedDictionaries 合并，页面/控件可直接 StaticResource 取用。

    ★ 浅色 / 深色：颜色令牌全部放进 ResourceDictionary.ThemeDictionaries 的 Light / Dark 两套字典里，
      两边**必须成对出现同名键**（缺一个就会在切主题时运行时崩）。
      页面/控件里引用颜色一律用 {ThemeResource ...}（StaticResource 不会随主题刷新）；
      控件样式键（ApplePrimaryButtonStyle 等）与字体键（AppleFontFamily 等）仍然用 {StaticResource ...}。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════
         一、颜色与画刷（主题字典：Light / Dark）
         两套字典里的键必须一一对应；主窗口切换 RootGrid.RequestedTheme 时由框架重新解析。
         ═══════════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ─────────────── 浅色（Apple 白底） ─────────────── -->
        <ResourceDictionary x:Key="Light">

            <Color x:Key="PageBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="SurfaceBackgroundColor">#FFF5F5F7</Color>
            <Color x:Key="SurfaceHoverColor">#FFEDEDF0</Color>
            <Color x:Key="TextPrimaryColor">#FF1D1D1F</Color>
            <Color x:Key="TextSecondaryColor">#FF6E6E73</Color>
            <Color x:Key="TextTertiaryColor">#FF86868B</Color>
            <Color x:Key="AccentColorCustom">#FF0071E3</Color>
            <Color x:Key="AccentHoverColor">#FF0077ED</Color>
            <Color x:Key="AccentPressedColor">#FF006EDB</Color>
            <Color x:Key="HairlineColor">#FFD2D2D7</Color>

            <!-- 背景渐变三层的色标（与下面的 BgLayerA/B/C 画刷取值保持一致） -->
            <Color x:Key="BgLayerA1">#FFEAF3FF</Color>
            <Color x:Key="BgLayerA2">#FFD9E8FF</Color>
            <Color x:Key="BgLayerB1">#FFF3ECFF</Color>
            <Color x:Key="BgLayerB2">#FFE7DAFF</Color>
            <Color x:Key="BgLayerC1">#FFE8FBF2</Color>
            <Color x:Key="BgLayerC2">#FFD6F6E6</Color>

            <SolidColorBrush x:Key="PageBackground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#FFEDEDF0" />

            <SolidColorBrush x:Key="TextPrimary" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FF6E6E73" />
            <SolidColorBrush x:Key="TextTertiary" Color="#FF86868B" />

            <SolidColorBrush x:Key="Accent" Color="#FF0071E3" />
            <SolidColorBrush x:Key="AccentHover" Color="#FF0077ED" />
            <SolidColorBrush x:Key="AccentPressed" Color="#FF006EDB" />

            <SolidColorBrush x:Key="Hairline" Color="#FFD2D2D7" />

            <!-- 失败 / 错误文字（浅色）：只给播放条上那个可见的错误位用，不改动任何既有配色 -->
            <SolidColorBrush x:Key="Danger" Color="#FFD70015" />

            <!-- 播放条滑块滑轨粗细（浅色）：与播放条样式里那份无主题兜底值保持一致 -->
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

            <!-- 主色（Accent）填充上的文字 / 图标：浅色与深色都用白色（深色的 PageBackground 是纯黑，不能拿来当字色） -->
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />

            <!-- 低透明度反馈层：只做 hover / 选中，避免再引入新色值 -->
            <SolidColorBrush x:Key="AccentSoft" Color="#120071E3" />

            <!-- 背景渐变三层（浅色：淡蓝 / 淡紫 / 薄荷） -->
            <LinearGradientBrush x:Key="BgLayerA" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#EAF3FF" Offset="0.0" />
                <GradientStop Color="#D9E8FF" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BgLayerB" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F3ECFF" Offset="0.0" />
                <GradientStop Color="#E7DAFF" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BgLayerC" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E8FBF2" Offset="0.0" />
                <GradientStop Color="#D6F6E6" Offset="1.0" />
            </LinearGradientBrush>

            <!-- 七、NavigationView 极简覆盖：Pane 半透明白、内容区透明，让根 Grid 的三色渐变透出来 -->
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CCFFFFFF" />

            <!-- 选中 / 悬停底色 -->
            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#FFEDEDF0" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FFEDEDF0" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FFEDEDF0" />

            <!-- 文字颜色 -->
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF1D1D1F" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FF1D1D1F" />

            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

        </ResourceDictionary>

        <!-- ─────────────── 深色（Apple 深色：纯黑底 + #1C1C1E 卡面） ─────────────── -->
        <ResourceDictionary x:Key="Dark">

            <Color x:Key="PageBackgroundColor">#FF000000</Color>
            <Color x:Key="SurfaceBackgroundColor">#FF1C1C1E</Color>
            <Color x:Key="SurfaceHoverColor">#FF2C2C2E</Color>
            <Color x:Key="TextPrimaryColor">#FFF5F5F7</Color>
            <Color x:Key="TextSecondaryColor">#FFA1A1A6</Color>
            <Color x:Key="TextTertiaryColor">#FF8E8E93</Color>
            <Color x:Key="AccentColorCustom">#FF0A84FF</Color>
            <Color x:Key="AccentHoverColor">#FF409CFF</Color>
            <Color x:Key="AccentPressedColor">#FF0068D6</Color>
            <Color x:Key="HairlineColor">#FF3A3A3C</Color>

            <!-- 背景渐变三层的色标（深色：暗蓝 / 暗紫 / 暗薄荷） -->
            <Color x:Key="BgLayerA1">#FF0B1B33</Color>
            <Color x:Key="BgLayerA2">#FF102A4C</Color>
            <Color x:Key="BgLayerB1">#FF1A1030</Color>
            <Color x:Key="BgLayerB2">#FF2A1B45</Color>
            <Color x:Key="BgLayerC1">#FF0C2A22</Color>
            <Color x:Key="BgLayerC2">#FF123B31</Color>

            <SolidColorBrush x:Key="PageBackground" Color="#FF000000" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#FF2C2C2E" />

            <SolidColorBrush x:Key="TextPrimary" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FFA1A1A6" />
            <SolidColorBrush x:Key="TextTertiary" Color="#FF8E8E93" />

            <SolidColorBrush x:Key="Accent" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentHover" Color="#FF409CFF" />
            <SolidColorBrush x:Key="AccentPressed" Color="#FF0068D6" />

            <SolidColorBrush x:Key="Hairline" Color="#FF3A3A3C" />

            <!-- 失败 / 错误文字（深色）：与浅色同键名成套 -->
            <SolidColorBrush x:Key="Danger" Color="#FFFF453A" />

            <!-- 播放条滑块滑轨粗细（深色）：与浅色同值，保证两套主题成套 -->
            <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

            <!-- 主色（Accent）填充上的文字 / 图标：深色下同样用白色（PageBackground 在这里是纯黑，不能当字色） -->
            <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />

            <SolidColorBrush x:Key="AccentSoft" Color="#260A84FF" />

            <!-- 背景渐变三层（深色：不要白色渐变） -->
            <LinearGradientBrush x:Key="BgLayerA" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1B33" Offset="0.0" />
                <GradientStop Color="#102A4C" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BgLayerB" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1030" Offset="0.0" />
                <GradientStop Color="#2A1B45" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="BgLayerC" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0C2A22" Offset="0.0" />
                <GradientStop Color="#123B31" Offset="1.0" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#CC1C1C1E" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#CC1C1C1E" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#CC1C1C1E" />

            <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="#FF3A3A3C" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#FF3A3A3C" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#FF3A3A3C" />

            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#FFA1A1A6" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="#FFA1A1A6" />

            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 与主题无关的中性画刷（两套主题共用，可以安全地用 StaticResource） -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

    <!-- ═══════════════════════════════════════════════════════════════════
         二、字体与排版
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- 应用级 FontFamily：统一 MiSans（本机已安装），后面是中英文回退 -->
    <FontFamily x:Key="AppleFontFamily">MiSans, MiSans Normal, SF Pro Display, Segoe UI Variable Display, Segoe UI, PingFang SC, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppleMonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>

    <!--
        隐式样式：全应用所有 TextBlock 默认就是这个无衬线回退串。
        刻意只放 FontFamily —— 颜色一律由具名样式或元素本身指定，
        避免隐式样式在没有显式前景色的地方产生意外覆盖。
        注意：FontIcon 不是 TextBlock，图标字体必须在每个 FontIcon 上显式写 FontFamily，
        不会被这里的 MiSans 覆盖。
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
    </Style>

    <!-- PageTitle 40 / SemiBold / 行距 1.15 -->
    <Style x:Key="ApplePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="46" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- SectionTitle 24 / SemiBold -->
    <Style x:Key="AppleSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- CardTitle 17 / SemiBold -->
    <Style x:Key="AppleCardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <!-- Headline 21 / SemiBold -->
    <Style x:Key="AppleHeadlineStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Body 17 / Normal / 行高 1.5 -->
    <Style x:Key="AppleBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Secondary 14 / Normal / TextSecondary -->
    <Style x:Key="AppleSecondaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Caption 12 / Normal / TextTertiary -->
    <Style x:Key="AppleCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 卡片小标签：12 / TextSecondary（大数字卡片的说明行） -->
    <Style x:Key="AppleCardCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource AppleCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
    </Style>

    <!-- 列表行第二行（13 / TextSecondary / 单行省略） -->
    <Style x:Key="AppleMetaStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- BigNumber 44 / SemiBold（统计大数字） -->
    <Style x:Key="AppleBigNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="50" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
    </Style>

    <!-- 识别文本阅读排版：17 / 行高 1.6(27) / TextSecondary -->
    <Style x:Key="AppleReadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="LineHeight" Value="27" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- 运行日志：等宽 12 / TextSecondary-->
    <Style x:Key="AppleLogTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
    </Style>

    <!-- 播放条上的时间码：等宽小字（12 / TextSecondary），固定最小宽度让「0:00 → 10:00」时进度条不左右跳 -->
    <Style x:Key="AppleTimeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppleMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="40" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         三、圆角 / 间距 / 阴影（阴影一律没有：只在下面出现 0 值说明）
         ═══════════════════════════════════════════════════════════════════ -->

    <CornerRadius x:Key="AppleCardCornerRadius">18</CornerRadius>
    <!-- 按钮圆角：键名沿用 ApplePillCornerRadius，值由「胶囊」改成 8（小圆角矩形 / 方形感） -->
    <CornerRadius x:Key="ApplePillCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AppleListItemCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="AppleSmallCornerRadius">10</CornerRadius>

    <Thickness x:Key="ApplePageMargin">56,48,56,48</Thickness>
    <Thickness x:Key="AppleSectionMargin">0,0,0,40</Thickness>
    <Thickness x:Key="AppleCardPadding">28</Thickness>

    <!-- 卡片：只有 #F5F5F7（浅）/ #1C1C1E（深）底色区分，没有边框、没有阴影 -->
    <Style x:Key="AppleCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource AppleCardPadding}" />
    </Style>

    <!-- 极细分隔线：只在确实需要分组时用（默认布局一律用间距，不用线） -->
    <Style x:Key="AppleHairlineDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource Hairline}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,12,0,12" />
    </Style>

    <!-- 大数字统计卡片：同一行并排 3~4 张，用更紧的内边距，窄窗口也不会把数字挤掉 -->
    <Style x:Key="AppleStatCardStyle" TargetType="Border" BasedOn="{StaticResource AppleCardBorderStyle}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="MinWidth" Value="140" />
    </Style>

    <!--
        底部播放条：一整条卡片（放在列表下方）。与普通卡片同底色 / 同圆角（18），
        但内边距压到 20,14 —— 播放条本身是一行控件，不需要 28 的呼吸感；依旧没有阴影、没有边框。
    -->
    <Style x:Key="ApplePlayerBarCardStyle" TargetType="Border" BasedOn="{StaticResource AppleCardBorderStyle}">
        <Setter Property="Padding" Value="20,14" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         四、按钮（小圆角矩形 8 / 无边框 / 无阴影 / 内边距 16,9 · 最小高 38）
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- 主按钮：小圆角矩形（圆角 8）、#0071E3 填充、白字、无边框无阴影 -->
    <Style x:Key="ApplePrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource OnAccent}" />
        <Setter Property="Background" Value="{ThemeResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ApplePillCornerRadius}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- Normal 也显式钉住填充色：实测仅靠 Style.Background + TemplateBinding 在运行时不生效 -->
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Accent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource AccentPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <!-- 内容（图标 + 文字）自带白色前景（OnAccent），禁用时改用中灰底，白字仍然清晰可读 -->
                                        <Setter Target="Root.Background" Value="{ThemeResource TextTertiary}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource OnAccent}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮：小圆角矩形（圆角 8）、#F5F5F7 填充、TextPrimary 字、hover #EDEDF0 -->
    <Style x:Key="AppleSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ApplePillCornerRadius}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Hairline}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceBackground}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextTertiary}" />
                                        <Setter Target="Content.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文字链接按钮：无底色、#0071E3 文字、圆角同样 8（hover 时给 #F5F5F7 底） -->
    <Style x:Key="AppleTextLinkButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource Accent}" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ApplePillCornerRadius}" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceBackground}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource AccentHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHover}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource AccentPressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{StaticResource TransparentBrush}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextTertiary}" />
                                        <Setter Target="Content.Opacity" Value="0.55" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 36×36 小圆角矩形播放按钮：#0071E3 填充、白字、圆角 8、边框 0、无阴影 -->
    <Style x:Key="AppleCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplePrimaryButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="{StaticResource ApplePillCornerRadius}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--
        导航栏底部的主题开关（紧凑态 36×36 图标按钮）：无底色、无边框，只在 hover 时给一层 SurfaceBackground。
        不用 AppleTextLinkButtonStyle，因为它带了 16,9 的内边距与 38 的最小高，塞不进 48px 宽的紧凑侧栏。
    -->
    <Style x:Key="ApplePaneIconButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ApplePillCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{StaticResource TransparentBrush}"
                            BorderThickness="0"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceBackground}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         五、列表行（透明底 / hover #F5F5F7 / 选中 #EDEDF0 / 圆角 12 / 无分隔线）
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="AppleAudioRowStyle" TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,14" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        ContentTransitions="{TemplateBinding ContentTransitions}"
                        Padding="{TemplateBinding Padding}"
                        Background="{StaticResource TransparentBrush}"
                        PointerOverBackground="{ThemeResource SurfaceBackground}"
                        PressedBackground="{ThemeResource SurfaceHover}"
                        SelectedBackground="{ThemeResource SurfaceHover}"
                        SelectedPressedBackground="{ThemeResource SurfaceHover}"
                        SelectedPointerOverBackground="{ThemeResource SurfaceHover}"
                        CornerRadius="12"
                        ContentMargin="0"
                        SelectionCheckMarkVisualEnabled="False"
                        SelectionIndicatorVisualEnabled="False"
                        CheckBrush="{StaticResource TransparentBrush}"
                        FocusVisualMargin="0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯文本行（失败项等只读列表）：同一套行样式，语义别名，便于以后单独调整 -->
    <Style x:Key="ApplePlainRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource AppleAudioRowStyle}" />

    <!-- ═══════════════════════════════════════════════════════════════════
         六、输入类控件：#F5F5F7 底、无边框、圆角 10、内边距 14,8
         ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="AppleSubtleTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleSmallCornerRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource TextTertiary}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="AppleSubtleComboBoxStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleSmallCornerRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="AppleSubtleComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleSmallCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid x:Name="Root" Background="{StaticResource TransparentBrush}">
                        <ContentPresenter x:Name="Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceBackground}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SurfaceHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected" />
                                <VisualState x:Name="SelectedPointerOver" />
                                <VisualState x:Name="SelectedPressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextTertiary}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 细进度条（扫描进度：高 4，无边框，圆角） -->
    <Style x:Key="AppleThinProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{ThemeResource SurfaceHover}" />
        <Setter Property="Foreground" Value="{ThemeResource Accent}" />
    </Style>

    <!--
        播放条的进度 / 音量滑块：WinUI 的滑轨粗细由主题资源 SliderTrackThemeHeight 决定，
        这里统一加粗到 4px（与 AppleThinProgressBarStyle 的细进度条同粗），并保证 20px 的最小高度，
        拖动时手指 / 鼠标有足够的命中区域。**只覆盖几何尺寸**，模板行为仍是系统默认
        （拖动、键盘、无障碍都在），所以不会出现自写模板缺部件导致的拖动失效。
    -->
    <x:Double x:Key="SliderTrackThemeHeight">4</x:Double>

    <Style x:Key="AppleSeekSliderStyle" TargetType="Slider">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════
         七、NavigationView 极简覆盖（与主题无关的几何部分）
         · Pane 底色 / 内容区透明 / 选中与悬停底色 / 导航项文字色都在上面的主题字典里按浅深两套给；
           这里只放圆角、间距、竖条尺寸这些不随主题变化的东西。
         · 这些键名在 WinUI 1.8 的资源表里都存在；同名键会被本字典覆盖。
         ═══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>

    <!-- 左侧选中竖条：高度 / 宽度归零，等价于彻底去掉 -->
    <x:Double x:Key="NavigationViewSelectionIndicatorWidth">0</x:Double>
    <x:Double x:Key="NavigationViewSelectionIndicatorHeight">0</x:Double>

    <!-- 圆角与间距：选中项圆角 10；分组标题与叶子共用同一套底色
         CompactPaneLength=48 时，左右各 4 的边距 → 导航项可用宽 40，16px 图标仍然居中不溢出。 -->
    <CornerRadius x:Key="NavigationViewItemCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    <Thickness x:Key="NavigationViewItemMargin">4,2,4,2</Thickness>

    <!-- 分组内的项不做额外的缩进装饰，只留必要层级缩进 -->
    <Thickness x:Key="NavigationViewItemButtonMargin">0</Thickness>

    <!-- 导航项：选中态由 NavigationViewItemPresenter 负责，这里只覆盖容器本身 -->
    <Style x:Key="AppleNavItemStyle" TargetType="NavigationViewItem">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="0,1,0,1" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- 隐式应用：树里动态生成的导航项（代码创建，拿不到显式 Style）也统一走上面这套 -->
    <Style TargetType="NavigationViewItem" BasedOn="{StaticResource AppleNavItemStyle}" />

    <!-- ═══════════════════════════════════════════════════════════════════
         八、控件全局弱化（去边框 / 去掉焦点描边带来的粗线）
         ═══════════════════════════════════════════════════════════════════ -->

    <!-- 复选框与数字框只弱化底色与边框，保留默认模板行为 -->
    <Style x:Key="AppleSubtleCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimary}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style x:Key="AppleSubtleNumberBoxStyle" TargetType="NumberBox">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource AppleSmallCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- 展开器（更多筛选）：无边框、圆角、弱标题 -->
    <Style x:Key="AppleExpanderStyle" TargetType="Expander">
        <Setter Property="FontFamily" Value="{StaticResource AppleFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
